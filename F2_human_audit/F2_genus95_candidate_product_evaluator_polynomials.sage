def _base_function_from_coeffs(coeffs):
    return sum(C(c) * y^i for i, c in enumerate(coeffs))

gamma_numerators = [
    [_base_function_from_coeffs(c) for c in gamma]
    for gamma in gamma_numerator_coeffs
]

def _eval_polynomial_x_function(f, x0):
    K0 = parent(x0)
    return K0(f.numerator()(x0))

def eval_base_polynomial_function(f, P):
    x0, y0 = P[0], P[1]
    K0 = parent(x0)
    total = K0(0)
    coeffs = list(f.list()) + [K(0)] * 4
    for i, coeff in enumerate(coeffs[:4]):
        if coeff:
            total += _eval_polynomial_x_function(coeff, x0) * y0^i
    return total

# For fixed k, `gamma_numerator_coeffs[k][j][i]` is a polynomial in F2[x],
# and the numerator evaluator is
#
#     gamma_numerators[k](x,y,z1,z2,z3) =
#         sum_{j=0}^7 (sum_{i=0}^3 gamma_numerator_coeffs[k][j][i](x) * y^i) * M_j,
#
# with the cover monomials M_j ordered as:
#
#     j=0: 1
#     j=1: z3
#     j=2: z2
#     j=3: z2*z3
#     j=4: z1
#     j=5: z1*z3
#     j=6: z1*z2
#     j=7: z1*z2*z3
#
# The precomputed `gamma_numerators[k][j]` is the parenthesized base-curve
# coefficient in F2(C).  At runtime, `eval_product_reduced(coeffs, P)` is called
# with `coeffs = gamma_numerators[k]` and P=(x0,y0,z1,z2,z3).  The common
# denominator H=product_denominator is evaluated and divided out by
# `eval_product_functional`.  The evaluator assumes P already satisfies the
# base curve equation and the three Artin-Schreier cover equations.
def eval_product_reduced(coeffs, P):
    z_values = P[2:5]
    K0 = parent(P[0])
    total = K0(0)
    for coeff, exps in zip(coeffs, cover_basis_exponents):
        term = eval_base_polynomial_function(coeff, P)
        if term:
            for z_value, exp in zip(z_values, exps):
                if exp:
                    term *= z_value
            total += term
    return total

def eval_product_functional(P):
    denom = eval_base_polynomial_function(product_denominator, P)
    if denom == 0:
        raise ZeroDivisionError('point lies in the common denominator zero locus')
    return vector([eval_product_reduced(coeffs, P) / denom for coeffs in gamma_numerators])

def eval_product_codeword(product_message, P):
    lam = eval_product_functional(P)
    return sum(product_message[i] * lam[i] for i in range(222))
