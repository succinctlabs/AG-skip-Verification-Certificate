 'x^25 + x^24 + x^23 + x^22 + x^21 + x^16 + x^14 + x^11 + x^10 + x^9 + x^8 + x'], ['x^30 + x^29 + x^27 + x^26 + x^25 + x^24 + x^22 + x^21 + x^20 + x^19 + x^18 + x^17 + x^13 + x^6 + x^5 + x^2', 'x^29 + x^28 + x^26 + x^25 + x^22 + x^21 + x^18 + x^17 + x^11 + x^10 + x^7 + x^3 + x^2 + x', 'x^26 + x^20 + x^19 + x^17 + x^16 + x^13 + x^8 + x^2', 'x^24 + x^22 + x^21 + x^19 + x^16 + x^14 + x^12 + x^10 + x^7 + x^6 + x^4 + x']], [['x^30 + x^29 + x^27 + x^26 + x^24 + x^23 + x^17 + x^15 + x^14 + x^12 + x^11 + x^10 + x^8 + x^7 + x^5 + x^2', 'x^27 + x^25 + x^23 + x^22 + x^18 + x^16 + x^15 + x^14 + x^7 + x^6 + x^2 + x', 'x^26 + x^24 + x^23 + x^22 + x^21 + x^19 + x^18 + x^15 + x^14 + x^13 + x^11 + x^9 + x^7 + x^6 + x^5 + x^3', 'x^21 + x^20 + x^18 + x^17 + x^16 + x^13 + x^12 + x^11 + x^9 + x^5 + x^2 + x'], ['x^27 + x^26 + x^25 + x^24 + x^23 + x^22 + x^21 + x^20 + x^19 + x^18 + x^17 + x^16 + x^14 + x^13 + x^8 + x^7', 'x^28 + x^27 + x^26 + x^25 + x^24 + x^21 + x^18 + x^17 + x^16 + x^10 + x^9 + x^8 + x^4 + x^3', 'x^27 + x^24 + x^23 + x^22 + x^19 + x^17 + x^16 + x^15 + x^14 + x^13 + x^7 + x^6 + x^5 + x^2', 'x^24 + x^22 + x^21 + x^19 + x^18 + x^17 + x^16 + x^14 + x^9 + x^7 + x^5 + x^3'], ['x^25 + x^17 + x^16 + x^15 + x^13 + x^10 + x^9 + x^7 + x^5 + x^3', 'x^29 + x^28 + x^27 + x^25 + x^24 + x^23 + x^22 + x^21 + x^19 + x^18 + x^17 + x^14 + x^13 + x^12 + x^11 + x^10 + x^9 + x^2', 'x^25 + x^21 + x^20 + x^19 + x^11 + x^10 + x^9 + x^7 + x^5 + x^4 + x^2 + x', 'x^25 + x^24 + x^19 + x^13 + x^12 + x^9 + x^8 + x^7 + x^6 + x^4 + x^3 + x'], ['x^30 + x^29 + x^27 + x^26 + x^25 + x^22 + x^17 + x^16 + x^15 + x^13 + x^11 + x^9 + x^8 + x^4', 'x^28 + x^27 + x^24 + x^21 + x^20 + x^19 + x^18 + x^15 + x^14 + x^11 + x^10 + x^8 + x^5 + x^3 + x^2 + x', 'x^24 + x^22 + x^20 + x^17 + x^16 + x^15 + x^14 + x^13 + x^11 + x^9 + x^8 + x^6 + x^5 + x^3 + x^2 + x', 'x^24 + x^23 + x^18 + x^17 + x^15 + x^12 + x^10 + x^7 + x^5 + x^4'], ['x^30 + x^29 + x^25 + x^21 + x^17 + x^14 + x^9 + x^7 + x^6 + x^4', 'x^22 + x^21 + x^20 + x^19 + x^17 + x^15 + x^14 + x^13 + x^12 + x^11 + x^10 + x^8 + x^7 + x^6 + x^5 + x^2', 'x^27 + x^26 + x^22 + x^21 + x^20 + x^19 + x^15 + x^14 + x^12 + x^5 + x^4 + x', 'x^25 + x^24 + x^22 + x^19 + x^18 + x^17 + x^16 + x^12 + x^11 + x^8 + x^7 + x^5 + x^3 + x'], ['x^30 + x^27 + x^25 + x^24 + x^23 + x^22 + x^20 + x^19 + x^17 + x^16 + x^14 + x^11 + x^10 + x^8', 'x^29 + x^28 + x^25 + x^24 + x^23 + x^20 + x^14 + x^12 + x^11 + x^9 + x^8 + x^6 + x^4 + x', 'x^27 + x^26 + x^20 + x^17 + x^16 + x^14 + x^13 + x^12 + x^9 + x^6 + x^5 + x', 'x^25 + x^23 + x^21 + x^19 + x^18 + x^16 + x^13 + x^10 + x^8 + x^4'], ['x^30 + x^26 + x^24 + x^23 + x^20 + x^19 + x^16 + x^11 + x^10 + x^8 + x^7 + x^6', 'x^28 + x^27 + x^22 + x^21 + x^18 + x^16 + x^15 + x^11 + x^10 + x^8 + x^7 + x^6 + x^4 + x', 'x^25 + x^24 + x^23 + x^21 + x^20 + x^19 + x^18 + x^17 + x^16 + x^15 + x^13 + x^12 + x^9 + x^7 + x^4 + x', 'x^25 + x^24 + x^23 + x^22 + x^16 + x^15 + x^12 + x^8 + x^6 + x^4'], ['x^30 + x^27 + x^26 + x^25 + x^24 + x^21 + x^15 + x^14 + x^9 + x^8 + x^7 + x^4', 'x^29 + x^26 + x^23 + x^21 + x^18 + x^17 + x^16 + x^15 + x^14 + x^11 + x^8 + x^6', 'x^25 + x^23 + x^21 + x^16 + x^14 + x^12 + x^11 + x^10 + x^8 + x^7 + x^6 + x^5 + x^2 + x', 'x^25 + x^18 + x^9 + x^6 + x^3 + x']]]
base_nonzero_terms_per_gamma = [8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8]
# Here max x degree is the largest numerator degree after clearing the common denominator.
base_max_x_degree_per_gamma = [31, 31, 31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30]

def _base_function_from_coeffs(coeffs):
    return sum(C(c) * y^i for i, c in enumerate(coeffs))

base_gamma_numerators = [
    [_base_function_from_coeffs(c) for c in gamma]
    for gamma in base_gamma_numerator_coeffs
]

def _eval_polynomial_x_function(f, x0):
    K0 = parent(x0)
    return K0(f.numerator()(x0))

def eval_base_polynomial_function(f, P):
    x0, y0 = P[0], P[1]
    K0 = parent(x0)
    total = K0(0)
    coeffs = list(f.list()) + [K(0)] * 4
    for i, coeff in enumerate(coeffs[:4]):
        if coeff:
            total += _eval_polynomial_x_function(coeff, x0) * y0^i
    return total

# For fixed j, `base_gamma_numerator_coeffs[j][k][i]` is a polynomial in
# F2[x], and the numerator evaluator is
#
#     base_gamma_numerators[j](x,y,z1,z2,z3) =
#         sum_{k=0}^7 (sum_{i=0}^3 base_gamma_numerator_coeffs[j][k][i](x) * y^i) * M_k,
#
# with the cover monomials M_k ordered as:
#
#     k=0: 1
#     k=1: z3
#     k=2: z2
#     k=3: z2*z3
#     k=4: z1
#     k=5: z1*z3
#     k=6: z1*z2
#     k=7: z1*z2*z3
#
# The common denominator H=base_denominator is evaluated and divided out by
# `eval_base_functional`.  The evaluator assumes P already satisfies the base
# curve equation and the three Artin-Schreier cover equations.
def eval_base_reduced(coeffs, P):
    z_values = P[2:5]
    K0 = parent(P[0])
    total = K0(0)
    for coeff, exps in zip(coeffs, cover_basis_exponents):
        term = eval_base_polynomial_function(coeff, P)
        if term:
            for z_value, exp in zip(z_values, exps):
                if exp:
                    term *= z_value
            total += term
    return total

def eval_base_functional(P):
    denom = eval_base_polynomial_function(base_denominator, P)
    if denom == 0:
        raise ZeroDivisionError('point lies in the common denominator zero locus')
    return vector([eval_base_reduced(coeffs, P) / denom for coeffs in base_gamma_numerators])

def eval_base_codeword(base_message, P):
    lam = eval_base_functional(P)
    return sum(base_message[j] * lam[j] for j in range(64))
